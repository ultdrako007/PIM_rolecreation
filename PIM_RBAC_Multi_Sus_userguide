### **Caso 3: Validar Herencia Antes de Ejecutar**

**Script de Pre-Validación**:

```powershell
<#
.SYNOPSIS
    Valida si hay conflictos por herencia antes de ejecutar PIM
#>

param(
    [string]$CsvPath,
    [string]$TargetSubscription
)

$csv = Import-Csv $CsvPath
$conflicts = @()

foreach ($row in $csv) {
    if (-not $row.AzureRoleDefinitionId) { continue }
    
    # Obtener ancestros del scope
    $scope = $row.AzureScope
    $ancestors = @()
    
    while ($scope -match '^(.+)/[^/]+$') {
        $scope = $matches[1]
        $ancestors += $scope
    }
    
    Write-Host "Verificando $($row.PrincipalId) en $($ancestors.Count) ancestros..." -ForegroundColor Cyan
    
    # Verificar cada ancestro
    foreach ($ancestorScope in $ancestors) {
        $assignments = Get-AzRoleAssignment -ObjectId $row.PrincipalId -Scope $ancestorScope -ErrorAction SilentlyContinue |
            Where-Object { $_.RoleDefinitionId -eq $row.AzureRoleDefinitionId }
        
        if ($assignments) {
            $conflicts += [PSCustomObject]@{
                PrincipalId = $row.PrincipalId
                RoleId = $row.AzureRoleDefinitionId
                RequestedScope = $row.AzureScope
                ConflictScope = $ancestorScope
                IsInherited = ($ancestorScope -ne $row.AzureScope)
            }
            
            Write-Host "  ⚠️  CONFLICTO en ancestro: $ancestorScope" -ForegroundColor Yellow
        }
    }
}

if ($conflicts.Count -gt 0) {
    Write-Host "`n⚠️  $($conflicts.Count) conflictos detectados" -ForegroundColor Red
    $conflicts | Format-Table -AutoSize
    Write-Host "`nRecomendación: Ejecutar con -AutoMigrate para resolver automáticamente" -ForegroundColor Yellow
}
else {
    Write-Host "`n✓ No se detectaron conflictos. Seguro para ejecutar." -ForegroundColor Green
}
```

